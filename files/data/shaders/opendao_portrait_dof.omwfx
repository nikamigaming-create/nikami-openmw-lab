fragment main {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        vec2 px = omw.rcpResolution * 7.0;
        vec3 sharp = omw_GetLastShader(omw_TexCoord).rgb;
        vec3 blurred = vec3(0.0);
        float blurWeight = 0.0;
        for (int y = -3; y <= 3; ++y)
        {
            for (int x = -3; x <= 3; ++x)
            {
                vec2 offset = vec2(float(x), float(y));
                float weight = exp(-0.125 * dot(offset, offset));
                blurred += omw_GetLastShader(omw_TexCoord + offset * px).rgb * weight;
                blurWeight += weight;
            }
        }
        blurred /= blurWeight;

        vec2 headSpace = vec2((omw_TexCoord.x - 0.515) / 0.205,
            (omw_TexCoord.y - 0.585) / 0.43);
        float headFocus = 1.0 - smoothstep(0.92, 1.04, length(headSpace));
        float torsoHorizontal = 1.0 - smoothstep(0.35, 0.43, abs(omw_TexCoord.x - 0.515));
        float torsoVertical = 1.0 - smoothstep(0.30, 0.40, omw_TexCoord.y);
        float actorFocus = max(headFocus, torsoHorizontal * torsoVertical);
        float circleOfConfusion = (1.0 - actorFocus) * 0.88;
        vec3 color = mix(sharp, blurred, circleOfConfusion);
        float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
        vec3 backgroundGrade = mix(vec3(luminance), color, 0.72)
            * vec3(0.66, 0.78, 1.02) + vec3(0.05, 0.085, 0.12);
        vec3 actorGrade = mix(vec3(luminance), sharp, 0.78)
            * vec3(0.88, 0.84, 0.84);
        color = mix(backgroundGrade, actorGrade, actorFocus);

        float maximum = max(color.r, max(color.g, color.b));
        float minimum = min(color.r, min(color.g, color.b));
        float paleMaterial = (1.0 - smoothstep(0.10, 0.22, maximum - minimum))
            * smoothstep(0.22, 0.42, luminance);
        float hairRegion = headFocus * smoothstep(0.38, 0.48, omw_TexCoord.y);
        color += vec3(0.17, 0.16, 0.14) * paleMaterial * hairRegion;
        omw_FragColor = vec4(clamp(color, 0.0, 1.0), 1.0);
    }
}

technique {
    passes = main;
    description = "OpenDAO portrait depth of field";
    author = "OpenDAO";
    version = "1.0";
}

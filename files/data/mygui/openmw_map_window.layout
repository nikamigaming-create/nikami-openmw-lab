<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window_Pinnable" layer="Windows" position="0 0 300 300" name="_Main">
        <Property key="MinSize" value="40 40"/>

        <Widget type="ImageBox" skin="ImageBox" position="0 0 300 300" align="Stretch" name="PipBoyBackdrop">
            <Property key="ImageTexture" value="textures\interface\shared\background\pipboy.dds"/>
            <Property key="Colour" value="#174d26"/>
            <Property key="NeedMouse" value="false"/>
            <Property key="Visible" value="false"/>
        </Widget>
        <Widget type="TextBox" skin="NormalText" position="42 18 220 26" align="Top HStretch" name="PipBoyHeader">
            <Property key="Caption" value="PIP-BOY 3000  //  MAP"/>
            <Property key="TextColour" value="#74ff86"/>
            <Property key="TextAlign" value="Left VCenter"/>
            <Property key="NeedMouse" value="false"/>
            <Property key="Visible" value="false"/>
        </Widget>
        <Widget type="TextBox" skin="NormalText" position="42 270 216 20" align="Bottom HStretch" name="PipBoyFooter">
            <Property key="Caption" value="TESTMAP01  //  LOCAL MAP"/>
            <Property key="TextColour" value="#58d86d"/>
            <Property key="TextAlign" value="Center VCenter"/>
            <Property key="NeedMouse" value="false"/>
            <Property key="Visible" value="false"/>
        </Widget>

        <!-- Local map -->
        <Widget type="ScrollView" skin="MW_MapView" position="24 62 252 188" align="Stretch" name="LocalMap">
            <Widget type="ImageBox" skin="RotatingSkin" position="0 0 32 32" align="Top Left" name="CompassLocal">
                <Property key="ImageTexture" value="textures\compass.dds"/>
            </Widget>

            <Widget type="Button" skin="" position_real="0 0 1 1" name="EventBoxLocal" align="Stretch">
                <Property key="Depth" value="10"/>
            </Widget>
        </Widget>

        <!-- Global map -->
        <Widget type="ScrollView" skin="MW_MapView" position="24 62 252 188" align="Stretch" name="GlobalMap">
            <Widget type="ImageBox" skin="ImageBox" position_real="0 0 1 1" align="Stretch" name="GlobalMapImage">
                <Widget type="ImageBox" skin="ImageBox" position_real="0 0 1 1" align="Stretch" name="GlobalMapOverlay"/>
            </Widget>

            <Widget type="ImageBox" skin="RotatingSkin" position="0 0 32 32" align="Top Left" name="CompassGlobal">
                <Property key="ImageTexture" value="textures\compass.dds"/>
            </Widget>

            <Widget type="Button" skin="" position_real="0 0 1 1" name="EventBoxGlobal" align="Stretch"/>
        </Widget>

        <!-- World button -->
        <Widget type="AutoSizedButton" skin="MW_Button" position="213 244 61 22" align="Bottom Right" name="WorldButton">
            <Property key="ExpandDirection" value="Left"/>
            <Property key="NeedKey" value="false"/>
        </Widget>

    </Widget>
</MyGUI>
